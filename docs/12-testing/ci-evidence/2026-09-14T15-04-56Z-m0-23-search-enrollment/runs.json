c1f01b012e34d2f0a0f","tree_id":"171f8949add234f1d3e9e90dd09aa4e881e1ad16","message":"feat(search): انتظامُ services/search في الترحيلاتِ العكوسةِ + بابٌ خامسٌ يُلزِمُ بها (M0-23 · الموجةُ 6)\n\nالدَينُ كانَ مُعلَناً بالحرفِ في TASK_LOG يومَ مراجعةِ M5-12 («ترحيلٌ يُولَّدُ\nلاحقاً عندَ إضافةِ طبقةِ قاعدةِ البياناتِ») ثمَّ أُضيفتِ الطبقةُ ولم يُولَّدِ\nالترحيلُ — فالوعدُ المكتوبُ في سجلٍّ ليسَ حارساً.\n\n- مرآةُ Drizzle لستِّ جداولٍ بأسماءِ قيودٍ كنونيّةٍ (NOT_MIRRORED_TABLES = [])\n- 0000_married_songbird.sql مولَّدٌ كنونيّاً + ذيلٌ مُعلَمٌ (pg_trgm · فهرسا gin\n  · دالّتا plpgsql · 4 مُطلِقاتٍ) واللقطةُ لم تُمَسَّ\n- رفيقُ ترجعٍ يُسقِطُ الامتدادَ صراحةً — فإبقاؤهُ يُخفِقُ في بُعدِ الدوالِّ بالقياسِ\n- migrate.ts مكتبةٌ بلا بيئةٍ · migrate-cli.ts القارئُ الوحيدُ لـDATABASE_URL\n- بابٌ خامسٌ في validate-migrations.sh: خدمةٌ لها قاعدةٌ فعليّةٌ (عقدٌ فيهِ\n  CREATE TABLE + استيرادُ pg) وهيَ غيرُ منتظِمةٍ تُرفَضُ إلّا بإعفاءٍ مُعلَنٍ\n  بسببٍ (≥ 4 كلماتٍ — قِيسَ أوّلاً بـ${#var} فعبرَتهُ كلمةٌ عربيّةٌ واحدةٌ\n  بـ12 بايتاً، وحالةُ الطفرةِ هيَ التي كشفَت ذلكَ)\n\nالمقيسُ محلّيّاً على PostgreSQL 18.6: 0 فروقٍ في سبعةِ أبعادِ كتالوجٍ ·\nالأبعادُ السبعةُ فارغةٌ بعدَ الترجعِ · 20/20 تكامليّاً · 86/86 وحدويّاً ·\n6 حالاتِ حوكمةٍ جديدةٍ (267 ⇒ 273 · 0 فاشلةٍ) · verify.sh EXIT=0.\n\nحكمُ CI: NOT VERIFIED · account_billing_blocked (RISK-0039).\nالمجموعُ 14 خدمةً/حزمةً منتظِمةً · لم يبقَ عقدٌ فيهِ جداولُ بلا ترحيلٍ.\n\nWork Item: M0-23 · Claims: CLM-0162 · CLM-0163","timestamp":"2026-09-14T15:02:24Z","author":{"name":"wasla-agent","email":"saaraanvg@outlook.com"},"committer":{"name":"wasla-agent","email":"saaraanvg@outlook.com"}},"repository":{"id":1352934013,"node_id":"R_kgDOUKQifQ","name":"wasla","full_name":"skyosv10-art/wasla","private":true,"owner":{"login":"skyosv10-art","id":291345653,"node_id":"U_kgDOEV2U9Q","avatar_url":"https://avatars.githubusercontent.com/u/291345653?v=4","gravatar_id":"","url":"https://api.github.com/users/skyosv10-art","html_url":"https://github.com/