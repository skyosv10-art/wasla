# WASLA Prometheus — M2-08 Stage B
# Pre-built Prometheus image with WASLA scrape config
# Render sets PORT automatically — Prometheus must listen on it.
FROM prom/prometheus:v2.54.1

COPY prometheus.yml /etc/prometheus/prometheus.yml
COPY alert-rules.yml /etc/prometheus/alert-rules.yml

# Use shell form so $PORT is expanded at runtime (Render sets PORT).
# Fall back to 9090 for local runs.
CMD ["sh", "-c", "prometheus --web.listen-address=:${PORT:-9090} --config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/prometheus --web.enable-lifecycle"]
