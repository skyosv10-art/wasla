# WASLA Prometheus — M6-18C (CLM-0403)
# The image ENTRYPOINT is /bin/prometheus, so the previous CMD ["sh","-c",…] was
# passed to Prometheus as arguments ("unexpected sh", update_failed 2026-09-24).
# `--web.enable-lifecycle` is dropped: on a public URL it lets anyone POST /-/quit.
FROM prom/prometheus:v2.54.1

COPY prometheus.yml /etc/prometheus/prometheus.yml
COPY alert-rules.yml /etc/prometheus/alert-rules.yml
COPY prometheus-entrypoint.sh /etc/prometheus/entrypoint.sh

ENTRYPOINT ["/bin/sh", "/etc/prometheus/entrypoint.sh"]
