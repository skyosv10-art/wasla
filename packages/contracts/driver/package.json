{
  "name": "@wasla/contracts-driver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "تبرير الحزمة (§7): سطح TypeScript موحّد لعقود نواة السائق الكنسية كي تستهلكها المطابقة وبوت السائق والإدارة بلا نسخ أو تنفيذ داخل الحزمة.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../../../services/drivers/contracts/api.openapi.yml -o src/api-types.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "openapi-typescript": "^7.13.0",
    "vitest": "^2.1.0"
  }
}
