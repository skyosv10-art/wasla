{
  "name": "@wasla/telegram-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WASLA Telegram channel adapter — the only place that knows Telegram Bot API. Implements ChannelPort and UpdateParserPort of @wasla/channel-core (ADR-007).",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@wasla/channel-core": "workspace:*",
    "@wasla/contracts-channel": "workspace:*",
    "@wasla/errors": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "vitest": "^2.1.0"
  }
}
