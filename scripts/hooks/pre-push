#!/usr/bin/env bash
# pre-push — ينفّذ قاعدة "لا دفع بلا توثيق" محلياً قبل الدفع إلى المستودع.
#
# التفعيل (مرة واحدة لكل نسخة محلية):
#   git config core.hooksPath scripts/hooks
#   chmod +x scripts/hooks/pre-push scripts/checks/require-doc-update.sh
#
# ملاحظة: الإلزام الفعلي يحدث خادمياً عبر job الـ doc-coverage في .gitlab-ci.yml،
# لأن المطور قد يستخدم --no-verify لتجاوز هذا الـ hook. الهدف هنا التنبيه المبكر.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
SCRIPT="$REPO_ROOT/scripts/checks/require-doc-update.sh"

if [ -z "$REPO_ROOT" ] || [ ! -x "$SCRIPT" ]; then
  echo "تحذير: سكربت فحص التوثيق غير موجود أو غير قابل للتنفيذ في $SCRIPT — تخطّي الفحص المحلي." >&2
  echo "        (تذكير: الإلزام الفعلي يتم خادمياً عبر CI job: doc-coverage)" >&2
  exit 0
fi

ZERO="0000000000000000000000000000000000000000"
STATUS=0

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  if [ "$LOCAL_SHA" = "$ZERO" ]; then
    # حذف فرع — لا فحص.
    continue
  fi
  if [ "$REMOTE_SHA" = "$ZERO" ]; then
    # فرع جديد على المستودع البعيد: قارن ضد main.
    "$SCRIPT" "origin/main" "$LOCAL_SHA" || STATUS=1
  else
    "$SCRIPT" "$REMOTE_SHA" "$LOCAL_SHA" || STATUS=1
  fi
done

exit $STATUS
