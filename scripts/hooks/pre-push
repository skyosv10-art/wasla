#!/usr/bin/env bash
# pre-push — ينفّذ قاعدة "لا دفع بلا توثيق" محلياً قبل الدفع إلى المستودع.
#
# التفعيل (مرة واحدة لكل نسخة محلية):
#   git config core.hooksPath scripts/hooks
#   chmod +x scripts/hooks/pre-push scripts/checks/require-doc-update.sh scripts/checks/scan-secrets.sh
#
# ملاحظة: الإلزام الفعلي يحدث خادمياً عبر job الـ doc-coverage في .gitlab-ci.yml،
# لأن المطور قد يستخدم --no-verify لتجاوز هذا الـ hook. الهدف هنا التنبيه المبكر.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
DOC_CHECK="$REPO_ROOT/scripts/checks/require-doc-update.sh"
SECRET_CHECK="$REPO_ROOT/scripts/checks/scan-secrets.sh"
CLAIM_CHECK="$REPO_ROOT/scripts/checks/validate-work-claims.sh"

if [ -z "$REPO_ROOT" ]; then
  echo "تحذير: تعذّر تحديد جذر المستودع — تخطّي الفحص المحلي." >&2
  echo "        (تذكير: الإلزام الفعلي يتم خادمياً عبر CI job: doc-coverage + repo-structure)" >&2
  exit 0
fi

ZERO="0000000000000000000000000000000000000000"
STATUS=0

# فحص الأسرار أولاً (تنبيه مبكر — الإلزام الفعلي في CI job repo-structure).
if [ -x "$SECRET_CHECK" ]; then
  "$SECRET_CHECK" || STATUS=1
else
  echo "تحذير: سكربت فحص الأسرار غير موجود أو غير قابل للتنفيذ في $SECRET_CHECK — تخطّي الفحص المحلي." >&2
fi

if [ ! -x "$DOC_CHECK" ]; then
  echo "تحذير: سكربت فحص التوثيق غير موجود أو غير قابل للتنفيذ في $DOC_CHECK — تخطّي فحص التوثيق المحلي." >&2
  echo "        (تذكير: الإلزام الفعلي يتم خادمياً عبر CI job: doc-coverage)" >&2
fi

# فحص حجز النطاق: منع تكرار العمل بين جهتين (docs/00-rules/WORK_CLAIM_RULE.md).
if [ ! -x "$CLAIM_CHECK" ]; then
  echo "تحذير: سكربت فحص الحجوزات غير موجود في $CLAIM_CHECK — تخطّي." >&2
  echo "        (تذكير: الإلزام الفعلي خادمياً عبر CI job: governance-guard)" >&2
fi

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  if [ "$LOCAL_SHA" = "$ZERO" ]; then
    # حذف فرع — لا فحص.
    continue
  fi
  if [ "$REMOTE_SHA" = "$ZERO" ]; then
    # فرع جديد على المستودع البعيد: قارن ضد main.
    BASE="origin/main"
  else
    BASE="$REMOTE_SHA"
  fi
  [ -x "$CLAIM_CHECK" ] && { "$CLAIM_CHECK" "$BASE" "$LOCAL_SHA" || STATUS=1; }
  [ -x "$DOC_CHECK" ]   && { "$DOC_CHECK"   "$BASE" "$LOCAL_SHA" || STATUS=1; }
done

if [ "$STATUS" -ne 0 ]; then
  echo "" >&2
  echo "الدفع مرفوض محلياً. للتشخيص الكامل: bash scripts/checks/verify-governance.sh" >&2
  echo "المرجع: docs/16-progress/README.md" >&2
fi

exit $STATUS
