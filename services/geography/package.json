{
  "name": "@wasla/geography-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WASLA Geography & Localization service — pure domain core, ports & use cases (Phase 02).",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "tsx watch src/http/server.ts",
    "start": "node --import tsx src/http/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@wasla/service-auth": "workspace:*",
    "@wasla/contracts-geography": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "@wasla/identity-service": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "vitest": "^2.1.0"
  }
}
