{
  "name": "@wasla/matching-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WASLA Matching service — من المرشّحون وبأي ترتيب، مع طبقة HTTP على المنفذ 8088 (Phase 07).",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "tsx watch src/http/server.ts",
    "start": "node --import tsx src/http/server.ts"
  },
  "dependencies": {
    "@wasla/contracts-matching": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "vitest": "^2.1.0",
    "tsx": "^4.23.12"
  }
}
