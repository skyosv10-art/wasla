{
  "name": "@wasla/orders-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WASLA Order Engine service — the order lifecycle: transition table, domain, ports, use cases, in-memory + Postgres adapters, HTTP layer on 8087 (Phase 06).",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "tsx watch src/http/server.ts",
    "start": "node --import tsx src/http/server.ts"
  },
  "dependencies": {
    "@wasla/contracts-order": "workspace:*",
    "@wasla/service-auth": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@wasla/auth-sdk": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "vitest": "^2.1.0"
  }
}
