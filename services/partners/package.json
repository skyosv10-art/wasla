{
  "name": "@wasla/partners-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/http/app.ts",
      "import": "./src/http/app.ts"
    },
    "./infrastructure/*": {
      "types": "./src/infrastructure/*.ts",
      "import": "./src/infrastructure/*.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --experimental-strip-types src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@wasla/config": "workspace:*",
    "@wasla/auth-sdk": "workspace:*",
    "@wasla/service-auth": "workspace:*",
    "@wasla/observability": "workspace:*",
    "fastify": "^5.0.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "vitest": "^3.0.0",
    "typescript": "^5.6.0",
    "drizzle-kit": "^0.28.0"
  }
}
