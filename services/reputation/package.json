{
  "name": "@wasla/reputation-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WASLA Reputation & Fraud service — السمعة نتيجةٌ مُشتقّة من دفتر وقائع، والاحتيال إشاراتٌ مُسمّاة لا حُكم، والخدمة لا تعاقب أحداً (Phase 09 · MR 3/6: استمراريةٌ على Postgres بوحدة عمل، وحزمةُ مطابقةٍ تركض على المُهيئين بنفس السيناريوهات).",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./http": {
      "types": "./src/http/app.ts",
      "import": "./src/http/app.ts"
    },
    "./runner": {
      "types": "./src/runner.ts",
      "import": "./src/runner.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "tsx watch src/http/server.ts",
    "start": "node --import tsx src/http/server.ts"
  },
  "dependencies": {
    "@wasla/contracts-reputation": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "vitest": "^2.1.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12"
  }
}
