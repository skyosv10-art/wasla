{
  "name": "@wasla/subscriptions-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WASLA Subscriptions & Referrals service — الحالةُ مُشتقّةٌ من دفتر مُدَدٍ لا حقلٌ يُكتب، والمكافأةُ مدةٌ لا رصيد، ولا عمودَ مالٍ واحدٍ هنا (Phase 10 · MR 4/6: معاملةٌ واحدةٌ تكتب المدّةَ والانتقالَ والصفَّ المُتحقِّق، وطبقةُ HTTP باثنتَي عشرةَ عمليّةً على المنفذ 8093).",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./db": {
      "types": "./src/db/index.ts",
      "import": "./src/db/index.ts"
    },
    "./app": {
      "types": "./src/app/index.ts",
      "import": "./src/app/index.ts"
    },
    "./http": {
      "types": "./src/http/app.ts",
      "import": "./src/http/app.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node --import tsx src/db/migrate-cli.ts",
    "dev": "tsx watch src/http/server.ts",
    "start": "node --import tsx src/http/server.ts"
  },
  "dependencies": {
    "@wasla/contracts-subscription": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "vitest": "^2.1.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12"
  }
}
